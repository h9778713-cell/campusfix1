# ==============================================================================
# CampusFix Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5000

# Microsoft SQL Server Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CampusFixDB
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000
DB_POOL_MAX=20
DB_POOL_MIN=2

# Authentication & Security
JWT_SECRET=campusfix_jwt_super_secret_key_change_in_production_min32chars!
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
SESSION_COOKIE_NAME=campusfix_token

# Image / Attachment Storage
# Provider options: 'local' (local disk storage), 'cloud_s3' (AWS S3 or S3-compatible), 'cloud_azure' (Azure Blob)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Cloud S3 / S3-Compatible Storage Settings (Required if STORAGE_PROVIDER=cloud_s3)
S3_BUCKET=your_s3_bucket_name_here
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_aws_access_key_id_here
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Azure Blob Storage Settings (Required if STORAGE_PROVIDER=cloud_azure)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONTAINER_NAME=campusfix-complaints
AZURE_STORAGE_ACCESS_KEY=your_azure_storage_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
